---
import { Mail } from '@lucide/astro';
---

<header class="shell header">
  <div class="identity">
    <a class="name" href="/">Allan Wheeler</a>
    <!-- <span>Data Visualization Engineer</span> -->
  </div>
  <nav class="contact-links" aria-label="Contact links">
    <a href="mailto:allanxdata@gmail.com" aria-label="Email Allan Wheeler">
      <Mail aria-hidden="true" size={18} stroke-width={1.6} />
    </a>
    <a href="https://github.com/allanwheeler" aria-label="Allan Wheeler on GitHub" target="_blank" rel="noreferrer">
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 .7a11.5 11.5 0 0 0-3.64 22.4c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.17.08 1.78 1.2 1.78 1.2 1.04 1.77 2.72 1.26 3.38.96.1-.75.4-1.26.74-1.55-2.57-.3-5.27-1.29-5.27-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.16 1.18a10.9 10.9 0 0 1 5.75 0c2.19-1.49 3.15-1.18 3.15-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.71 5.39-5.29 5.68.42.36.79 1.06.79 2.14v3.26c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z" />
      </svg>
    </a>
  </nav>
</header>
<style>
  .header {
    color: var(--text-color);
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding-block: 12px;
    /* border-bottom: 1px dashed #999; */
  }
  .name {
    font-weight: 600;
    font-size: 1.35em;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }
  .identity {
    display: grid;
    gap: 3px;
  }
  .identity span {
    color: var(--muted-text-color);
    font-size: 0.75em;
  }
  .contact-links {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .contact-links a {
    display: grid;
    place-items: center;
    padding: 2px;
  }
  .header a,
  .header a:hover,
  .header a:visited {
    color: var(--text-color);
    text-decoration: none;
  }
  .header a {
    transition-property: opacity;
    transition-duration: 150ms;
    transition-timing-function: ease-out;
  }
  .header a:hover {
    opacity: 0.6;
  }
  .header .contact-links a,
  .header .contact-links a:visited {
    color: var(--text-color);
    opacity: 1;
  }
  .header .contact-links a:hover {
    opacity: 0.6;
  }
</style>
