---
import { projectColumns, projects } from '../data/data';
import ProjectCard from './ProjectCard.astro';

const columns = [projectColumns.left, projectColumns.right];
---

<div class="gallery">
  {
    columns.map(column => (
      <div class="column">
        {column.map(project => <ProjectCard project={project} />)}
      </div>
    ))
  }
</div>
<div class="mobile-gallery">
  {
    projects.map(project => (
      <ProjectCard project={project} disableViewer={true} />
    ))
  }
</div>
<dialog class="viewer" aria-label="Full-size project media">
  <button class="close" type="button" aria-label="Close media viewer"
    >Close</button
  >
  <figure>
    <img src="" alt="" />
    <video src="" controls autoplay muted loop playsinline></video>
  </figure>
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('.viewer');
  const dialogImage = dialog?.querySelector('img');
  const dialogVideo = dialog?.querySelector('video');
  document
    .querySelectorAll<HTMLButtonElement>('.viewer-trigger')
    .forEach(trigger =>
      trigger.addEventListener('click', () => {
        if (!dialog || !dialogImage || !dialogVideo) return;
        const isVideo = trigger.dataset.mediaType === 'video';
        const source = trigger.dataset.fullMedia ?? '';
        dialogImage.hidden = isVideo;
        dialogVideo.hidden = !isVideo;
        dialogImage.src = isVideo ? '' : source;
        dialogImage.alt = isVideo ? '' : (trigger.dataset.alt ?? '');
        dialogVideo.src = isVideo ? source : '';
        dialog.showModal();
      }),
    );
  dialog
    ?.querySelector('.close')
    ?.addEventListener('click', () => dialog.close());
  dialog?.addEventListener('click', event => {
    if (event.target === dialog) dialog.close();
  });
</script>
<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .mobile-gallery {
    display: none;
  }
  .viewer {
    width: min(94vw, 1200px);
    max-width: none;
    max-height: 92vh;
    padding: 48px 24px 20px;
    border: 0;
    background: #fff;
    box-shadow:
      0 0 0 1px oklch(0 0 0 / 0.06),
      0 1px 2px -1px oklch(0 0 0 / 0.06),
      0 2px 4px oklch(0 0 0 / 0.04);
  }
  .viewer::backdrop {
    background: rgb(0 0 0 / 0.35);
  }
  .viewer figure {
    margin: 0;
  }
  .viewer :is(img, video) {
    display: block;
    max-width: 100%;
    max-height: calc(92vh - 100px);
    margin: auto;
    object-fit: contain;
  }
  .viewer [hidden] {
    display: none;
  }
  .close {
    position: absolute;
    top: 10px;
    right: 12px;
    border: 0;
    border-radius: 4px;
    padding: 6px 8px;
    background: transparent;
    cursor: pointer;
    transition-property: background-color, scale;
    transition-duration: 150ms;
    transition-timing-function: ease-out;
  }
  .close:hover {
    background: oklch(0 0 0 / 0.06);
  }
  .close:active {
    scale: 0.96;
  }
  @media (max-width: 700px) {
    .gallery {
      display: none;
    }
    .mobile-gallery {
      display: block;
    }
  }
</style>
